{
  "name": "@sorlros/detoks",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "bin": {
    "detoks": "bin/detoks.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tok-it/detoks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/src/",
    "README.md",
    "README.ko.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "prepare": "node -e \"const{existsSync}=require('fs');const tsc='./node_modules/typescript/bin/tsc';if(existsSync(tsc)){require('child_process').execSync('node '+tsc+' -p tsconfig.json',{stdio:'inherit'})}else{console.log('Skipping build: typescript not available in local node_modules')}\"",
    "prepack": "npm run build",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slide20": "vitest run slide20-generation/slide20-generator.test.ts",
    "test:slide20:report": "tsx slide20-generation/test-runner.ts",
    "test:slide20:all": "npm run test:slide20 && npm run test:slide20:report",
    "verify:role1": "tsx scripts/verify-role1.ts",
    "verify:role1:rows": "tsx scripts/verify-role1.ts --file tests/data/row_data.json",
    "benchmark": "tsx scripts/benchmark-pipeline.ts",
    "benchmark:llm": "tsx scripts/benchmark-llm-runtime.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "node-llama-cpp": "^3.18.1",
    "node-pty": "^1.1.0",
    "tiktoken": "^1.0.22",
    "tsx": "4.20.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "node-llama-cpp": "^3.18.1",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
